# Dentist Workflow Automation Environment Configuration
PORT=5055
NODE_ENV=development

# OpenAI ChatGPT Intelligence Configuration
# Set your real OpenAI API Key here for live LLM inference.
# If left as MOCK_OPENAI_KEY, system operates in deterministic clinical simulation mode.
OPENAI_API_KEY=MOCK_OPENAI_KEY
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_ESCALATION_MODEL=gpt-4o

# Clinic & Scheduling Configuration
CLINIC_NAME="Dr. XYZ Multispeciality Dental & Implant Clinic"
HEAD_DENTIST_NAME="Dr. XYZ (BDS, MDS - Prosthodontist & Implantologist)"
CLINIC_PHONE="+91 98765 43210"
CLINIC_ADDRESS="Suite 402, Lotus Healthcare Park, Linking Road, Bandra West, Mumbai, MH 400050"
DEFAULT_DEPOSIT_INR=500
SLOT_HOLD_MINUTES=10

# WhatsApp Cloud API (For future live migration - Meta Graph API v21.0)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="dentist_webhook_secret_2027"
